
cd "D:\jx-web mới"

Copy-Item ".\opencode.json" ".\opencode.json.backup-qwen38" -Force

@'
{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.5:9b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen3.5 9B Local",
          "tool_call": true,
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  }
}
'@ | Set-Content ".\opencode.json" -Encoding utf8

Get-Content ".\opencode.json" -Raw | ConvertFrom-Json | Out-Null
Write-Host "Da cap nhat cau hinh sang Qwen3.5 9B."
